# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- LLM ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=
GEMINI_GROUNDING=false

GOOGLE_SA_JSON_PATH=
GOOGLE_SHEET_ID=

# ---- Search ----
SEARCH_PROVIDER=fixture
SEARCH_FIXTURE_PATH=tests/fixtures/search_people.json
EMAIL_FINDER=none

# ---- Gate 4: does the email domain belong to the company? ----
# rules  = no model: domain equals the company domain or carries its name; Seamless/Apollo emails trusted (default)
# hybrid = rules first, Gemini only when the domain and company do not line up
# gemini = Gemini for every lead (the original behaviour; costs one call per lead)
ENTITY_CHECK=rules
ENTITY_MIN_CONFIDENCE=0.7

# ---- Gate 5 ----
MAILBOX_VERIFIER=dev_skip
ZEROBOUNCE_API_KEY=

# ---- Sourcing ----
APIFY_TOKEN=

# ---- Google Sheets (Phase 4) ----
# Service account key file. Never commit it (secrets/ is gitignored).
GOOGLE_SA_JSON_PATH=
# The ID between /d/ and /edit in the Sheet URL (pasting the whole URL also works).
# Share the Sheet with the service account's email as Editor.
GOOGLE_SHEET_ID=

# ---- Storage ----
LEDGER_PATH=data/ledger.db

DRAFT_CONCURRENCY=3
# Email finder: none | apollo | apollo_pattern | seamless | seamless_pattern
# Seamless.AI key: Settings -> Public API -> API Key. 1 credit per lead looked up.
SEAMLESS_API_KEY=
APOLLO_API_KEY=

# search_jobs -> Jobs_Pipeline: the campaign (Campaigns tab Name, or a JSON path) whose offer, sender company and
# persona the job emails use. Must be CORPORATE with an offer. Default: Jobs
JOBS_CAMPAIGN=

# ---- HTTP API for the web console (npm run api) ----
API_PORT=8787
API_HOST=127.0.0.1
# Empty on your laptop. On a shared server set a long random string; the console asks for it once.
API_TOKEN=
# Where the built frontend lives, if you want the API to serve it on the same port.
FRONTEND_DIST=../LinkedIn-MCP-Engine-Frontend/dist

# Job search: who finds the jobs. "jobspy" reads real listings (Indeed, LinkedIn, ...) with JobSpy and needs
# Python 3.10+ and: pip install -U python-jobspy. Empty or "gemini" uses Gemini's Google Search (needs GEMINI_GROUNDING=true).
# Gemini still checks leads (gate 4) and writes the drafts either way; Seamless still finds the emails.
JOB_SEARCH_SOURCE=
# Optional JobSpy settings. Empty means the default:
# JOBSPY_PYTHON python on Windows, python3 elsewhere | JOBSPY_SITES indeed,linkedin (also glassdoor, zip_recruiter)
# JOBSPY_LOCATION United States | JOBSPY_HOURS_OLD 72 | JOBSPY_COUNTRY_INDEED USA | JOBSPY_PROXIES comma-separated user:pass@host:port
JOBSPY_PYTHON=
JOBSPY_SITES=
JOBSPY_LOCATION=
JOBSPY_HOURS_OLD=
JOBSPY_COUNTRY_INDEED=
JOBSPY_PROXIES=
# Job search skips staffing, recruiting and IT consulting firms (competitors). Add more company names here, comma-separated.
SKIP_COMPANIES=


# ---- Locks ----
# One job search and one campaign run at a time, across the console API, Claude Desktop (MCP) and the CLI.
# Lock files live in out/locks; a lock older than 30 minutes is treated as abandoned. Change the folder only if
# two installs share one machine and must not block each other.
LOCK_DIR=

# Most Seamless lookups in one job search (default 10). Only jobs with an email are kept, so more lookups usually means more drafts.
JOB_SEARCH_MAX_LOOKUPS=

# ---- Tuning (all optional; empty uses the default shown) ----
# Google Calendar that AutoBooker-side tools read; empty = the primary calendar of the Google account
GOOGLE_CALENDAR_ID=
# Gemini / Ollama request timeout in ms (60000)
LLM_TIMEOUT_MS=
# Local model instead of Gemini: URL (http://localhost:11434), model (qwen2.5:7b), thinking on/off (true/false)
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_THINK=
# Campaign lead search: Google searches per run (8), searches at once (3), email lookups at once (5)
XRAY_MAX_QUERIES=
XRAY_SEARCH_CONCURRENCY=
EMAIL_FINDER_CONCURRENCY=
# JobSpy: stop one search after this many ms (180000)
JOBSPY_TIMEOUT_MS=
