# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- LLM: ollama for testing, gemini for production ----
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# For thinking models (qwen3, deepseek-r1): false = answer directly. Leave empty for other models.
OLLAMA_THINK=false
LLM_TIMEOUT_MS=60000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Default thinking for every call: low, medium, high, or empty for the model default. Gate 4 always uses low.
GEMINI_THINKING=
# Google Search grounding. Gemini 3 offers it only on a billed project: keep false on the free tier.
GEMINI_GROUNDING=false

# ---- Lead search (gemini_xray campaigns): fixture = offline sample data, gemini = live LinkedIn X-Ray ----
SEARCH_PROVIDER=fixture
SEARCH_FIXTURE_PATH=tests/fixtures/search_people.json
# How gemini_xray leads get an email. "none" = use what search returned (Hunter/Prospeo later)
EMAIL_FINDER=none

# ---- Writer (Phase 3): leads drafted at the same time ----
DRAFT_CONCURRENCY=3

# ---- Gate 4 ----
ENTITY_MIN_CONFIDENCE=0.7

# ---- Gate 5: zerobounce for real checks, dev_skip for local testing (refused in production) ----
MAILBOX_VERIFIER=dev_skip
ZEROBOUNCE_API_KEY=

# ---- Sourcing (Phase 8) ----
APIFY_TOKEN=

# ---- Google Sheets ----
GOOGLE_SA_JSON_PATH=
GOOGLE_SHEET_ID=

# ---- Storage ----
LEDGER_PATH=data/ledger.db
