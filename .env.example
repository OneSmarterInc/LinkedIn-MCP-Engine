# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info

# ---- LLM ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=
GEMINI_GROUNDING=false

GOOGLE_SA_JSON_PATH=
GOOGLE_SHEET_ID=

# ---- Search ----
SEARCH_PROVIDER=fixture
SEARCH_FIXTURE_PATH=tests/fixtures/search_people.json
EMAIL_FINDER=none

# ---- Gate 4 ----
ENTITY_MIN_CONFIDENCE=0.7

# ---- Gate 5 ----
MAILBOX_VERIFIER=dev_skip
ZEROBOUNCE_API_KEY=

# ---- Sourcing ----
APIFY_TOKEN=

# ---- Google Sheets (Phase 4) ----
# Service account key file. Never commit it (secrets/ is gitignored).
GOOGLE_SA_JSON_PATH=
# The ID between /d/ and /edit in the Sheet URL (pasting the whole URL also works).
# Share the Sheet with the service account's email as Editor.
GOOGLE_SHEET_ID=

# ---- Storage ----
LEDGER_PATH=data/ledger.db

DRAFT_CONCURRENCY=3